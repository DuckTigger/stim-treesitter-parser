{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "stim",
      "camelcase": "Stim",
      "title": "Stim",
      "scope": "source.stim",
      "file-types": [
        "stim"
      ],
      "injection-regex": "^stim$",
      "class-name": "TreeSitterStim"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for stabiliser circuits in the Stim quantum circuit language.",
    "authors": [
      {
        "name": "Andrew Patterson",
        "email": "andrew.pattersonap24@googlemail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-stim"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}