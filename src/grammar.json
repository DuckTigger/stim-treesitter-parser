        {
          "type": "PATTERN",
          "value": "-\\d+"
        },
        {
          "type": "PATTERN",
          "value": "\\d+\\.\\d*"
        },
        {
          "type": "PATTERN",
          "value": "-\\d+\\.\\d*"
        },
        {
          "type": "PATTERN",
          "value": "\\d*\\.\\d+"
        },
        {
          "type": "PATTERN",
          "value": "-\\d*\\.\\d+"
